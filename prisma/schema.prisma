// WealthPilot — Multi-Tenant PostgreSQL Schema
// Shenzhen International FinTech Competition-2026 Audit Standard
//
// Key Design Principles:
// 1. Strict Multi-Tenancy: Every domain entity references User with onDelete: Cascade
// 2. Minor-Unit Precision: Monetary amounts stored as BigInt cents (eliminating float errors & BDT overflow)
// 3. GDPR Article 17 Compliance: Deleting a User cascades and obliterates all associated records
// 4. Performance: Composite indices on [userId, financialDate], [userId, category], [accountId]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------------------------------
// USER IDENTITY & AUTHENTICATION (NextAuth.js v5 compatible)
// -----------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String? // Salted hash for credentials auth (Argon2id/Bcrypt)
  preferredCurrency  String    @default("USD") // any ISO 4217 code (src/lib/currency.ts)
  timezone           String    @default("UTC")
  isAiEnabled        Boolean   @default(false) // Opt-in; only /user/ai-consent writes it (SEC-11)
  aiConsentAt        DateTime?
  aiConsentVersion   String?
  aiProviders        String[]  @default([])
  chatHistoryEnabled Boolean   @default(false)
  region             String? // ISO-3166 alpha-2, user-declared; null = most restrictive rules
  uiPrefs            Json      @default("{}") // theme, locale, dateFormat, reducedMotion, isDemoMode: UI-only
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relational Integrity & GDPR Art. 17 Cascading Erasure
  accounts             FinancialAccount[]
  transactions         Transaction[]
  budgets              BudgetCategory[]
  savingsGoals         SavingsGoal[]
  bills                BillSubscription[]
  debts                DebtAccount[]
  auditLogs            AuditEvent[]
  copilotMessages      CopilotMessage[]
  copilotConversations CopilotConversation[]
  sessions             Session[]
  merchantRules        MerchantRule[]
  pageInsights         PageInsight[]
  investmentPlans      InvestmentPlan[]
  loanOffers           LoanOffer[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// FINANCIAL ACCOUNTS & LIABILITIES
// -----------------------------------------------------------------------------

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  INVESTMENT
  CASH
  LOAN
}

model FinancialAccount {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  institution          String
  type                 AccountType @default(CHECKING)
  currency             String      @default("USD")
  balanceCents         BigInt      @default(0) // Legacy cache; the API derives balance = opening + SUM(non-VOID tx)
  openingBalanceCents  BigInt      @default(0)
  accountNumberMask    String // GLBA 16 CFR § 314.4 compliant (e.g. "•••• 4821")
  isManual             Boolean     @default(true)
  isIncludedInNetWorth Boolean     @default(true)
  lastSyncedAt         DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  transactions Transaction[]
  bills        BillSubscription[]

  @@index([userId])
  @@map("financial_accounts")
}

// -----------------------------------------------------------------------------
// TRANSACTION LEDGER & SPLITS (Double-entry ready)
// -----------------------------------------------------------------------------

enum TransactionStatus {
  PENDING
  CLEARED
  RECONCILED
  VOID
}

enum TransactionSource {
  MANUAL
  CSV_IMPORT
  BANK_FEED
  DEMO
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  account            FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financialDate      String // YYYY-MM-DD
  postedAt           DateTime          @default(now())
  merchant           String
  normalizedMerchant String
  category           String
  amountCents        BigInt // Minor-units (Inflow > 0, Outflow < 0)
  currency           String            @default("USD")
  status             TransactionStatus @default(CLEARED)
  isTransfer         Boolean           @default(false)
  linkedTransferId   String? // For transfer pairing
  source             TransactionSource @default(MANUAL)
  importFingerprint  String? // sha256, CSV_IMPORT rows only; NULL when voided
  importBatchId      String?
  notes              String?
  tags               String[]          @default([])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  splits TransactionSplit[]

  @@unique([userId, importFingerprint])
  @@index([userId, financialDate])
  @@index([userId, category])
  @@index([accountId])
  @@index([userId, importBatchId])
  @@map("transactions")
}

model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      String
  amountCents   BigInt // Split minor-unit allocation
  note          String?

  @@index([transactionId])
  @@map("transaction_splits")
}

// -----------------------------------------------------------------------------
// BUDGET ENVELOPES & PACING
// -----------------------------------------------------------------------------

model BudgetCategory {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              String
  allocatedCents        BigInt // Spending ceiling in cents
  monthYear             String // YYYY-MM
  rolloverEnabled       Boolean  @default(false)
  alertThresholdPercent Int      @default(85)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, category, monthYear])
  @@index([userId])
  @@map("budget_categories")
}

// -----------------------------------------------------------------------------
// SAVINGS GOALS & MILESTONES
// -----------------------------------------------------------------------------

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetCents   BigInt
  currentCents  BigInt    @default(0)
  targetDate    String? // YYYY-MM-DD (optional for flexible milestones)
  category      String
  priority      String    @default("medium") // low | medium | high
  isPaused      Boolean   @default(false)
  plan          Json? // latest AI goal plan snapshot (what the plan dialog renders); history not kept
  planUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@map("savings_goals")
}

// -----------------------------------------------------------------------------
// RECURRING BILLS & OBLIGATIONS
// -----------------------------------------------------------------------------

enum BillFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

model BillSubscription {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amountCents BigInt
  frequency   BillFrequency     @default(MONTHLY)
  nextDueDate String // YYYY-MM-DD
  category    String
  isAutoPay   Boolean           @default(false)
  accountId   String?
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status      String            @default("active")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@map("bill_subscriptions")
}

// -----------------------------------------------------------------------------
// DEBT PAYOFF ENGINE (Avalanche / Snowball)
// -----------------------------------------------------------------------------

model DebtAccount {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  balanceCents        BigInt
  aprPercent          Float // e.g. 24.99
  minimumPaymentCents BigInt
  dueDateDay          Int // 1 - 31
  category            String // credit_card, student_loan, mortgage, personal_loan
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("debt_accounts")
}

// -----------------------------------------------------------------------------
// IMMUTABLE AUDIT TRAIL (SOX Section 302/404 & Compliance Logging)
// -----------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String // "TRANSACTION_CREATE", "LEDGER_RECONCILE", etc.
  actor          String // "USER", "SYSTEM", "COPILOT"
  details        String // Redacted event summary
  ipAddress      String?
  userAgent      String?
  checksumBefore String? // SOX cryptographic hash prior to mutation
  checksumAfter  String // SOX cryptographic hash after mutation
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// AI COPILOT CHAT & AUDITED EVIDENCE TRAIL
// -----------------------------------------------------------------------------

model CopilotMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String // "user", "assistant", "system"
  content       String
  evidenceScope String? // Audited tool call evidence reference
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("copilot_messages")
}

/// One saved assistant chat (only when the user turned on chat history). messages = the client's CopilotMessage[].
model CopilotConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("copilot_conversations")
}

// -----------------------------------------------------------------------------
// SESSIONS, RATE LIMITS, CATEGORIZATION RULES
// -----------------------------------------------------------------------------

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model RateLimitBucket {
  key     String   @id // e.g. "login:email:<sha256>"; never raw emails or IPs
  count   Int
  resetAt DateTime

  @@map("rate_limit_buckets")
}

model MerchantRule {
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedMerchant String // lower-cased keyword matched with "contains"
  category           String
  updatedAt          DateTime @updatedAt

  @@id([userId, normalizedMerchant])
  @@map("merchant_rules")
}

// -----------------------------------------------------------------------------
// FX RATES (one row per UTC day; not user data)
// -----------------------------------------------------------------------------

model FxSnapshot {
  day       String   @id // YYYY-MM-DD (UTC)
  base      String // rates are units of each currency per 1 `base`
  rates     Json // { "BDT": "122150000000", ... } scaled by FX_SCALE (1e9) as integer strings
  source    String
  fetchedAt DateTime @default(now())

  @@map("fx_snapshots")
}

// -----------------------------------------------------------------------------
// PER-PAGE AI INSIGHT CACHE (latest per user + page; saves AI quota on tab switches)
// -----------------------------------------------------------------------------

model PageInsight {
  userId    String
  segment   String
  payload   Json // CopilotAnswer: facts are server-computed, text is template or grounded narration
  dataHash  String // changes when the user's data changes, which invalidates the cache
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, segment])
  @@map("page_insights")
}

// -----------------------------------------------------------------------------
// WEALTH PLANNER: investment plans and loan offers (rates in basis points, money in minor units)
// -----------------------------------------------------------------------------

model InvestmentPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  country           String // ISO-3166 alpha-2: where the money is invested
  currency          String
  initialCents      BigInt
  monthlyCents      BigInt
  horizonMonths     Int
  riskProfile       String // conservative | balanced | growth
  expectedReturnBps Int? // user override; null = derived from country data + risk profile
  taxBps            Int      @default(0) // tax on gains
  scenarios         String[] @default([])
  allocation        Json? // [{ symbol, label, weightPct }] summing to 100: the chosen fund mix
  mixName           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("investment_plans")
}

model LoanOffer {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  lender         String
  principalCents BigInt
  aprBps         Int
  termMonths     Int
  feeCents       BigInt   @default(0)
  purpose        String // personal | car | home | education | business
  country        String?
  status         String   @default("considering") // considering | taken
  debtId         String? // the DebtAccount created when taken
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("loan_offers")
}

// Public World Bank indicators per country (not user data), refreshed every 30 days.
model CountryMacro {
  country   String   @id // ISO-3166 alpha-2
  data      Json
  source    String
  fetchedAt DateTime @default(now())

  @@map("country_macros")
}

// Public third-party data (bank lists, news, market history) cached by key. Never user data.
model ExternalCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())

  @@map("external_cache")
}

// Organisations with a partnership, sponsorship or advertising deal (managed by admins; not user data).
model Partner {
  id           String    @id @default(cuid())
  name         String
  website      String?
  relationship String // partner | sponsor | advertiser (shown on every offer card)
  contractEnds DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  offers       Offer[]

  @@map("partners")
}

// A partner's discount or investment opportunity in one country. OFR-01.
model Offer {
  id             String          @id @default(cuid())
  partnerId      String
  partner        Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kind           String // discount | investment
  title          String
  description    String
  discountBps    Int? // 1500 = 15% off
  country        String // ISO-3166 alpha-2
  termsUrl       String
  actionUrl      String?
  validFrom      DateTime
  validUntil     DateTime
  lastVerifiedAt DateTime
  isSample       Boolean         @default(false) // demo content, shown with a "Sample" badge
  status         String          @default("draft") // draft | live | paused
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  locations      OfferLocation[]
  stats          OfferStat[]

  @@index([country, status, validUntil])
  @@map("offers")
}

// Where an offer can be used in person. Online-only offers have none.
model OfferLocation {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  label   String
  lat     Float
  lng     Float

  @@index([offerId])
  @@map("offer_locations")
}

// Anonymous daily counts for sponsor reports: no user id, no location.
model OfferStat {
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD (UTC)
  views   Int    @default(0)
  clicks  Int    @default(0)

  @@id([offerId, day])
  @@map("offer_stats")
}
