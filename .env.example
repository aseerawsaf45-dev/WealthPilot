# ==============================================================================
# WealthPilot — Environment Configuration Template
# Shenzhen International FinTech Competition-2026
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your PostgreSQL database URL (Free tier Supabase or Neon).
# 3. Generate a secure random string for NEXTAUTH_SECRET:
#    openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Neon Lakebase Postgres)
# ------------------------------------------------------------------------------
# Neon pooled connection string for application runtime queries:
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.c-6.[REGION].aws.neon.tech/neondb?sslmode=require"

# Neon direct unpooled connection string for Prisma migrations & schema pushing:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:[PASSWORD]@[HOST].c-6.[REGION].aws.neon.tech/neondb?sslmode=require"

# Neon Branch Name:
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# 2. Neon Managed Auth Configuration (Better Auth)
# ------------------------------------------------------------------------------
NEON_AUTH_BASE_URL="https://[AUTH_HOST].neonauth.c-6.[REGION].aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://[AUTH_HOST].neonauth.c-6.[REGION].aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate-32-byte-secure-random-secret-for-session-cookies"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Encryption (NextAuth.js v5)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-base64-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Free AI Copilot Subsystem (Google AI Studio Gemini Flash)
# ------------------------------------------------------------------------------
# Get your 100% free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional Failover LLM (Groq Cloud Free Tier)
# Get free key at: https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------------------
# 4. Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
