# ==============================================================================
# WealthPilot — Environment Configuration Template
# Shenzhen International FinTech Competition-2026
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your PostgreSQL database URL (Free tier Supabase or Neon).
# 3. Generate SESSION_SECRET and AUDIT_PEPPER (see section 2).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Neon Lakebase Postgres)
# ------------------------------------------------------------------------------
# Neon pooled connection string for application runtime queries:
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.c-6.[REGION].aws.neon.tech/neondb?sslmode=require"

# Neon direct unpooled connection string for Prisma migrations & schema pushing:
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:[PASSWORD]@[HOST].c-6.[REGION].aws.neon.tech/neondb?sslmode=require"

# Neon Branch Name:
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# 2. Sessions & audit (REQUIRED — the app refuses to sign sessions without them)
# ------------------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value per environment (local, preview, production).
SESSION_SECRET=""
AUDIT_PEPPER=""
# Public origin of the app (used for the same-origin CSRF check)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Free AI Copilot Subsystem (Google AI Studio Gemini Flash)
# ------------------------------------------------------------------------------
# Get your 100% free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"  # 2.5 is closed to new users; check ai.google.dev/gemini-api/docs/models

# Primary LLM (Groq Cloud Free Tier; enable Zero Data Retention in Settings → Data Controls)
# Get free key at: https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# 4. Runtime Environment
# ------------------------------------------------------------------------------
# Do NOT set NODE_ENV here or in your host's (Hostinger/Vercel) environment variables:
# Next.js sets it itself. NODE_ENV=development during `next build` breaks prerendering.
PORT=3000

# Comma-separated emails that see the Admin tab (partner offers). Server-side only.
ADMIN_EMAILS=
