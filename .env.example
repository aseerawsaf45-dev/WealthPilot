# ==============================================================================
# WealthPilot — Environment Configuration Template
# Shenzhen International FinTech Competition-2026
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your PostgreSQL database URL (Free tier Supabase or Neon).
# 3. Generate a secure random string for NEXTAUTH_SECRET:
#    openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Supabase / Neon Free Tier)
# ------------------------------------------------------------------------------
# Example Supabase pooled connection string:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct connection string for Prisma migrations:
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
#
# Local development Postgres (if running local Docker or PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wealthpilot?sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Encryption (NextAuth.js v5)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-base64-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Free AI Copilot Subsystem (Google AI Studio Gemini Flash)
# ------------------------------------------------------------------------------
# Get your 100% free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional Failover LLM (Groq Cloud Free Tier)
# Get free key at: https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------------------
# 4. Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
