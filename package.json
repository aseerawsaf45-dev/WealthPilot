{
  "name": "wealthpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/next-prod.mjs build --webpack",
    "start": "node scripts/next-prod.mjs start",
    "lint": "eslint",
    "test": "tsx --test scripts/test-runner.mts",
    "postinstall": "prisma generate && node scripts/patch-tailwind.js && node scripts/copy-vendor.mjs",
    "check:security": "node scripts/security-compliance-check.js",
    "check:compliance": "node scripts/security-compliance-check.js",
    "test:compliance": "npm test",
    "tracker:status": "node scripts/project-tracker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:integration": "tsx --env-file=.env --test scripts/integration.mts",
    "eval:ai": "tsx scripts/ai-evals.mts",
    "eval:ai:live": "tsx --env-file=.env scripts/ai-live-check.mts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "eval:ai:plan:live": "tsx --env-file=.env scripts/ai-plan-live.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "heic2any": "0.0.4",
    "lucide-react": "^1.57.0",
    "motion": "12.43.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.3.289",
    "postcss": "^8.5.30",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
