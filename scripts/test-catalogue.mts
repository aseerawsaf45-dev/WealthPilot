/**
 * Builds docs/TEST_CASES.md from REAL runs: unit tests, DB integration tests (when DATABASE_URL
 * points at a Neon test branch) and AI evals. Each row is a test that just ran, with its result.
 *   npx tsx scripts/test-catalogue.mts            (integration skipped without DATABASE_URL)
 */

import fs from 'node:fs';
import { spawnSync } from 'node:child_process';

type Row = { suite: string; name: string; pass: boolean; ms: string };

function run(args: string[]): { out: string; ms: number } {
  const t = Date.now();
  const r = spawnSync('npx', args, { encoding: 'utf8', shell: true, env: process.env, maxBuffer: 64 * 1024 * 1024 });
  return { out: `${r.stdout ?? ''}${r.stderr ?? ''}`, ms: Date.now() - t };
}

/** node:test spec reporter → rows (suite = enclosing ▶ block). */
function parseSpec(out: string): Row[] {
  const rows: Row[] = [];
  let suite = '';
  for (const line of out.split(/\r?\n/)) {
    const s = line.match(/^▶ (.+)$/);
    if (s) suite = s[1].trim();
    const t = line.match(/^ {2}([✔✖]) (.+?)(?: \(([\d.]+)ms\))?$/);
    if (t) rows.push({ suite, name: t[2], pass: t[1] === '✔', ms: t[3] ? Number(t[3]).toFixed(1) : '' });
  }
  return rows;
}
const count = (out: string, key: string) => Number(out.match(new RegExp(`ℹ ${key} (\\d+)`))?.[1] ?? 0);

const unit = run(['tsx', '--test', '--test-reporter=spec', 'scripts/test-runner.mts']);
const unitRows = parseSpec(unit.out);
const hasDb = !!process.env.DATABASE_URL;
const integ = hasDb ? run(['tsx', '--test', '--test-reporter=spec', 'scripts/integration.mts']) : null;
const integRows = integ ? parseSpec(integ.out) : [];
const evals = run(['tsx', 'scripts/ai-evals.mts']);
const evalCases = (JSON.parse(fs.readFileSync('scripts/ai-evals.json', 'utf8')) as { cases: Array<{ id: string; question?: string; expect?: Record<string, unknown> }> }).cases;
const evalPass = new Set([...evals.out.matchAll(/^✔ (\S+)/gm)].map((m) => m[1]));
const evalTotal = evals.out.match(/(\d+)\/(\d+) eval cases passed/);
const tsc = run(['tsc', '--noEmit']);
const sec = spawnSync('node', ['scripts/security-compliance-check.js'], { encoding: 'utf8', shell: true });
const secOk = /ALL REGULATORY COMPLIANCE GATES PASSED/.test(`${sec.stdout}${sec.stderr}`);

const esc = (s: string) => s.replace(/\|/g, '\\|');
const table = (rows: Row[]) => {
  const suites = [...new Set(rows.map((r) => r.suite))];
  return suites
    .map((s) => {
      const rs = rows.filter((r) => r.suite === s);
      return `### ${esc(s || 'Top level')}\n\n| # | Test case | Result | Time (ms) |\n|---|---|---|---|\n${rs.map((r, i) => `| ${i + 1} | ${esc(r.name)} | ${r.pass ? 'PASS' : 'FAIL'} | ${r.ms} |`).join('\n')}\n`;
    })
    .join('\n');
};
const expectText = (e?: Record<string, unknown>) => {
  if (!e) return '';
  const parts: string[] = [];
  if (e.source) parts.push(`source=${e.source}`);
  if (Array.isArray(e.tools)) parts.push(`tools: ${e.tools.join(', ')}`);
  if (e.facts) parts.push(`${Object.keys(e.facts as object).length} exact facts`);
  if (Array.isArray(e.answerIncludes)) parts.push(`includes "${(e.answerIncludes as string[]).join('", "')}"`);
  if (Array.isArray(e.answerExcludes)) parts.push(`never says "${(e.answerExcludes as string[]).join('", "')}"`);
  if (Array.isArray(e.limitationIncludes)) parts.push('states a limitation');
  return parts.join('; ');
};

const date = new Date().toISOString().slice(0, 10);
const md = `# Test Cases and Results

Generated by \`scripts/test-catalogue.mts\` on ${date} from real runs of every suite. Each row below is a test that ran; nothing is typed by hand.

## 1. Summary

| Suite | Command | What it covers | Result |
|---|---|---|---|
| Unit and logic tests | \`npm test\` | Money maths, ML, planner maths, parsers, schemas, copilot router/commands/grounding, security helpers | **${count(unit.out, 'pass')} / ${count(unit.out, 'tests')} passed** (${count(unit.out, 'suites')} suites, ${(unit.ms / 1000).toFixed(1)} s) |
| Database integration tests | \`npm run test:integration\` (Neon **test branch**) | Repositories against real Postgres: derived balances, tenant isolation (404), idempotent bill pay, goal limits, audit hash chain, session revocation, partner-offer rules, admin guard | ${integ ? `**${count(integ.out, 'pass')} / ${count(integ.out, 'tests')} passed**` : 'not run here (needs DATABASE_URL of a test branch)'} |
| AI copilot evaluations | \`npm run eval:ai\` | Exact numbers, tool choice, schema validity, prompt-injection resistance, privacy | **${evalTotal ? `${evalTotal[1]} / ${evalTotal[2]}` : '?'} passed** |
| Type safety | \`npx tsc --noEmit\` | Whole project, strict TypeScript | ${tsc.out.trim() ? 'errors' : '**0 errors**'} |
| Security gates | \`npm run check:security\` | Secrets, layering (routes never call Prisma directly), compliance gates | ${secOk ? '**All gates passed**' : 'FAILED'} |
| End-to-end sandbox run | \`npx tsx scripts/sandbox-run.mts\` | 63 operations of two simulated users over HTTP on a production build | see \`docs/SANDBOX_OPERATION_LOG.md\` |

Pass bar used by the project: 100% of tests, 100% of eval numbers exact, 0 prompt-injection successes, 0 type errors.

## 2. How to run

\`\`\`bash
npm test                          # unit + logic (no database needed)
npm run eval:ai                   # AI evals with fake models (no API key needed)
npx tsc --noEmit                  # types
npm run check:security            # security / compliance gates
DATABASE_URL=<Neon test branch> npx tsx --test scripts/integration.mts   # never production
npx tsx scripts/test-catalogue.mts   # regenerates this file
\`\`\`

## 3. Unit and logic tests (${unitRows.length})

${table(unitRows)}
## 4. Database integration tests (${integRows.length})

${integRows.length ? table(integRows) : 'Not run in this generation (no DATABASE_URL).\n'}
## 5. AI copilot evaluation cases (${evalCases.length})

Each case runs the real orchestrator with fixture data and, where set, a scripted fake model reply (including hostile ones). A case passes only when every expected number matches exactly, the right tools ran and nothing forbidden appears.

| # | Case | Question | Expectation | Result |
|---|---|---|---|---|
${evalCases.map((c, i) => `| ${i + 1} | \`${c.id}\` | ${esc(String(c.question ?? '').slice(0, 90))} | ${esc(expectText(c.expect))} | ${evalPass.has(c.id) ? 'PASS' : 'FAIL'} |`).join('\n')}
`;
fs.writeFileSync('docs/TEST_CASES.md', md);

// Results by functional area for docs/TEST_REPORT.md (written between <!-- gen:areas --> markers).
const AREAS: Array<[string, RegExp]> = [
  ['Partner offers', /partner offers/i],
  ['Planning: budgets, goals, debts', /goal|Debt Payoff/i],
  ['Wealth planner: loans, investing, banks, markets', /Wealth planner|Debt-first|Bank picks|GDELT|mixes|Loans:|Copilot control of the Planner/i],
  // Import before AI: "Document extraction (… + AI grounding)" is an import suite.
  ['Import and document reading', /CSV Parsing|import|Document extraction|Ambiguous dates/i],
  ['AI copilot: grounding, commands, privacy', /Copilot|Grounding|privacy gateway|Assistant commands|chat history|bank brief/i],
  ['ML insights', /ML insights/i],
  ['Security, privacy and compliance', /Security|Privacy|GDPR|Sarbanes|Gramm|PCI|Multi-Tenant|Authentication|CSRF|input validation|Hooks|platform/i],
  ['Money, currencies and ledger', /Financial Math|Cash Flow|Net Worth|currencies|ledger|CRUD|mappers/i],
];
const areaOf = (suite: string) => AREAS.find(([, re]) => re.test(suite))?.[0] ?? 'Other';
const byArea = new Map<string, { unit: number; integ: number; pass: number; total: number }>();
const bump = (suite: string, kind: 'unit' | 'integ', pass: boolean) => {
  const a = byArea.get(areaOf(suite)) ?? { unit: 0, integ: 0, pass: 0, total: 0 };
  a[kind]++;
  a.total++;
  if (pass) a.pass++;
  byArea.set(areaOf(suite), a);
};
unitRows.forEach((r) => bump(r.suite, 'unit', r.pass));
integRows.forEach((r) => bump(r.suite, 'integ', r.pass));
const areaOrder = [...AREAS.map(([n]) => n), 'Other'].filter((n) => byArea.has(n));
const evalsPassed = evalCases.filter((c) => evalPass.has(c.id)).length;
const grand = unitRows.length + integRows.length + evalCases.length;
const grandPass = unitRows.filter((r) => r.pass).length + integRows.filter((r) => r.pass).length + evalsPassed;
const areasMd = `| Functional area | Unit / logic | DB integration | Passed |
|---|---|---|---|
${areaOrder.map((n) => { const a = byArea.get(n)!; return `| ${n} | ${a.unit} | ${a.integ} | ${a.pass} / ${a.total} |`; }).join('\n')}
| AI copilot evaluations (scripted models) | | | ${evalsPassed} / ${evalCases.length} |
| **All automated test cases** | **${unitRows.length}** | **${integRows.length}** | **${grandPass} / ${grand}** |

_Generated ${date} by \`scripts/test-catalogue.mts\`; integration ${integ ? 'ran on a Neon test branch' : 'was not run (no DATABASE_URL)'}._`;
if (fs.existsSync('docs/TEST_REPORT.md')) {
  const rep = fs.readFileSync('docs/TEST_REPORT.md', 'utf8');
  fs.writeFileSync('docs/TEST_REPORT.md', rep.replace(/<!-- gen:areas -->[\s\S]*?<!-- \/gen -->/, `<!-- gen:areas -->\n${areasMd}\n<!-- /gen -->`));
}
const failed = unitRows.filter((r) => !r.pass).length + integRows.filter((r) => !r.pass).length + evalCases.filter((c) => !evalPass.has(c.id)).length;
console.log(`unit ${unitRows.length}, integration ${integRows.length}, evals ${evalCases.length}, failed ${failed}, tsc ${tsc.out.trim() ? 'ERR' : 'ok'}, security ${secOk ? 'ok' : 'FAIL'}`);
