/**
 * Builds docs/ROUTE_INVENTORY.md: every API route, its HTTP methods, the permission tier its
 * wrapper enforces, its rate limits and whether it validates a body with Zod. Read from the source,
 * so the security report can't drift from the code. Exits 1 if any handler is unwrapped.
 *   npx tsx scripts/route-inventory.mts
 */

import fs from 'node:fs';
import path from 'node:path';

const ROOT = 'src/app/api/v1';
const files: string[] = [];
(function walk(dir: string) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walk(p);
    else if (e.name === 'route.ts') files.push(p);
  }
})(ROOT);

const TIER: Record<string, string> = { adminOnly: 'Admin', authed: 'User (own data)', handle: 'Public' };
type Row = { route: string; method: string; tier: string; limits: string; zod: string; note: string };
const rows: Row[] = [];
let unwrapped = 0;

for (const f of files.sort()) {
  const src = fs.readFileSync(f, 'utf8');
  const route = '/api/v1/' + path.relative(ROOT, path.dirname(f)).split(path.sep).join('/').replace(/\[(\w+)\]/g, ':$1');
  const limits = [...src.matchAll(/rateLimit(?:Hit)?\('([a-z:]+)',\s*\[[^\]]*\],\s*([\d_]+),\s*([\d_ *]+)\)/g)].map((m) => {
    const secs = Function(`return ${m[3].replace(/_/g, '')}`)() as number;
    return `${m[1]} ${m[2].replace(/_/g, '')}/${secs >= 86400 ? `${secs / 86400}d` : secs >= 3600 ? `${secs / 3600}h` : secs >= 60 ? `${secs / 60}min` : `${secs}s`}`;
  });
  // Limits applied inside shared helpers (AI quotas) are noted per route.
  if (/resolveLlm\(/.test(src)) limits.push('AI quotas (ai:day 20/1d, ai:global 3/1min)');
  const zod = /parseBody\(/.test(src) ? 'yes' : /searchParams/.test(src) ? 'query checked' : 'no body';
  const note = /maxDuration/.test(src) ? 'calls external services or AI' : '';
  for (const m of src.matchAll(/export const (GET|POST|PUT|PATCH|DELETE) = (\w+)/g)) {
    const tier = TIER[m[2]];
    if (!tier) unwrapped++;
    rows.push({ route, method: m[1], tier: tier ?? `UNWRAPPED (${m[2]})`, limits: limits.join('; ') || '-', zod, note });
  }
  for (const m of src.matchAll(/export (?:async )?function (GET|POST|PUT|PATCH|DELETE)\b/g)) {
    unwrapped++;
    rows.push({ route, method: m[1], tier: 'UNWRAPPED (plain function)', limits: limits.join('; ') || '-', zod, note });
  }
}

const count = (t: string) => rows.filter((r) => r.tier === t).length;
const md = `# Appendix A: Route-by-Route Permission Inventory

Generated by \`scripts/route-inventory.mts\` from the source of all ${files.length} route files (${rows.length} HTTP handlers). The tier is the wrapper the handler is exported through, so it cannot differ from the code.

| Tier (wrapper) | Handlers | Enforcement |
|---|---|---|
| Public (\`handle\`) | ${count('Public')} | Same-origin check on mutations, generic errors. Only sign-up, sign-in, sign-out and health. |
| User, own data (\`authed\`) | ${count('User (own data)')} | Valid HMAC cookie **and** live \`Session\` row; \`userId\` comes from the session only; repositories scope every query by it. |
| Admin (\`adminOnly\`) | ${count('Admin')} | \`authed\` plus the session user's email must be in \`ADMIN_EMAILS\` (server environment). |
| **Unwrapped** | **${unwrapped}** | ${unwrapped ? 'MUST BE FIXED' : 'None: every handler goes through a wrapper.'} |

| Route | Method | Tier | Rate limit(s) | Input validation | Note |
|---|---|---|---|---|---|
${rows.map((r) => `| \`${r.route}\` | ${r.method} | ${r.tier} | ${r.limits} | ${r.zod} | ${r.note} |`).join('\n')}
`;
fs.writeFileSync('docs/ROUTE_INVENTORY.md', md);
console.log(`${files.length} route files, ${rows.length} handlers: public ${count('Public')}, user ${count('User (own data)')}, admin ${count('Admin')}, unwrapped ${unwrapped}`);
process.exit(unwrapped ? 1 : 0);
